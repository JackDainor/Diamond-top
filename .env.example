# Copia estos valores en Vercel → Settings → Environment Variables

# Tu API key de Shop2TopUp (formato keyId.secret)
SHOP2TOPUP_API_KEY=

# Secreto del webhook (opcional, cuando lo configures en el panel)
SHOP2TOPUP_WEBHOOK_SECRET=

# Se crea automáticamente al instalar Neon en Vercel
DATABASE_URL=
